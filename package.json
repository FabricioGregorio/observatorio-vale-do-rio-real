{
  "name": "observatorio-vale-do-rio-real",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm tsx scripts/gerar-zip-anexos.ts && next build",
    "verificar": "pnpm tipos && pnpm lint && pnpm teste && pnpm a11y && pnpm pendencias",
    "tipos": "tsc --noEmit",
    "lint": "biome check .",
    "teste": "vitest run",
    "a11y": "playwright test testes/a11y",
    "pendencias": "tsx scripts/verificar-pendencias.ts",
    "migrar": "drizzle-kit migrate",
    "gerar-migracao": "drizzle-kit generate",
    "seed": "node -e \"console.log('Sem seed: banco ainda fora do escopo do bootstrap.')\"",
    "zip-anexos": "tsx scripts/gerar-zip-anexos.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@tailwindcss/postcss": "latest",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "next": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.10",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
