# Copie para .env.local e preencha. NUNCA commitar .env.local.
# Segredos de produção vivem apenas na Vercel e nos secrets do GitHub Actions.

# ── Banco ────────────────────────────────────────────────────────────
#
# Três credenciais, com menor privilégio, e nunca uma só para tudo.
#
# TLS é responsabilidade da URL, não do código: as URLs de produção e de
# preview terminam em `?sslmode=verify-full`, e não se confia no padrão do
# driver. Nenhum `ssl: {...}` fixo em `src/dados/cliente.ts`, `db/cliente.ts`
# ou `drizzle.config.ts` — é o que deixa o mesmo arquivo conectar em produção
# com TLS verificado e em Docker local sem TLS, sem ramificar por ambiente.
# Exceção: dev local em Docker e o serviço `postgres:16` do CI não expõem TLS
# e conectam sem `sslmode`. Vale para esses dois casos e nenhum outro.
# `rejectUnauthorized: false` e `sslmode=no-verify` são proibidos onde houver
# dado real: falha de certificado se diagnostica, não se silencia.
#
# Os roles são provisionamento, não migração. Nenhuma migração cria, altera
# ou remove role, e senha nunca entra em arquivo versionado. Ao provisionar,
# conceder privilégios padrão para que tabelas de migrações futuras já nasçam
# acessíveis:
#
#   GRANT CONNECT ON DATABASE <banco> TO <role>;
#   GRANT USAGE ON SCHEMA public TO <role>;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public
#     GRANT SELECT[, INSERT, UPDATE, DELETE] ON TABLES TO <role>;
#
# O `ALTER DEFAULT PRIVILEGES` precisa ser executado pelo role de migração:
# ele só vale para objetos criados por quem o definiu. É fácil de errar.

# Usuário da aplicação: role `app_observatorio`, somente SELECT.
# É a credencial que o site usa no build. Nunca recebe DDL.
DATABASE_URL=

# Usuário de manutenção: role `manutencao_observatorio`, com
# SELECT/INSERT/UPDATE/DELETE e sem DDL. Usado só por scripts de operação.
DATABASE_URL_MANUTENCAO=

# Usuário de migração: role dono do banco, com DDL. Exclusivo do Drizzle Kit
# e do CI. Migração versionada é o único mecanismo de mudança de schema.
DATABASE_URL_MIGRACAO=

# ── Storage ──────────────────────────────────────────────────────────
#
# Dois buckets independentes. O privado não tem URL pública: o código que o
# usa lê exclusivamente as variáveis STORAGE_PRIVATE_*, e nenhum endpoint ou
# objeto fictício é criado para contorná-lo.

# Armazenamento público de objetos (R2/S3 compatível)

STORAGE_PUBLIC_ENDPOINT=
STORAGE_PUBLIC_BUCKET=
STORAGE_PUBLIC_ACCESS_KEY=
STORAGE_PUBLIC_SECRET=
STORAGE_PUBLIC_URL=

# Declara que o pacote "Baixar tudo (.zip)" JÁ FOI publicado no bucket público
# por `pnpm publicar-zip`. Só o valor exato `true` conta; ausente ou qualquer
# outro valor significa não publicado, e a Prestação de Contas não oferece o
# download. Não definir por antecipação: a variável é declaração de fato
# consumado, não de intenção.
ZIP_ANEXOS_PUBLICADO=

# Armazenamento privado de objetos (R2/S3 compatível; sem URL pública)

STORAGE_PRIVATE_ENDPOINT=
STORAGE_PRIVATE_BUCKET=
STORAGE_PRIVATE_ACCESS_KEY=
STORAGE_PRIVATE_SECRET=

# Fonte canônica local dos originais — pasta FORA do repositório.
# Caminho absoluto da máquina. Não versionar o valor, e nunca escrever um
# caminho de usuário em código: o projeto lê esta variável.
OBSERVATORIO_FONTES_DIR=

# Revalidação sob demanda disparada pelo painel administrativo
REVALIDATE_SECRET=

# Anti-spam do formulário de escuta
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# URL pública canônica server-side — usada em sitemap, canonical e Open Graph
SITE_URL=

# Ambiente

NODE_ENV=development

# Futuro:
# usado somente para automação de depósito no Zenodo
ZENODO_API_TOKEN=
