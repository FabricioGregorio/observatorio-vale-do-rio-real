# Copie para .env.local e preencha. NUNCA commitar .env.local.
# Segredos de produção vivem apenas na Vercel e nos secrets do GitHub Actions.

# Banco — usuário da aplicação, SEM permissão de DDL
DATABASE_URL=

# Banco — usuário de migração, COM permissão de DDL. Usado só pelo CI.
# A separação impede que um agente altere o schema fora do fluxo de migração.
DATABASE_URL_MIGRACAO=

# Armazenamento de objetos (Vercel Blob, R2 ou S3)

STORAGE_PROVIDER=r2

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET=
STORAGE_PUBLIC_URL=

# Revalidação sob demanda disparada pelo painel administrativo
REVALIDATE_SECRET=

# Anti-spam do formulário de escuta
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# URL pública canônica — usada em RSS, sitemap, JSON-LD e Open Graph
NEXT_PUBLIC_SITE_URL=https://

# Ambiente

NODE_ENV=development

# Futuro:
# usado somente para automação de depósito no Zenodo
ZENODO_API_TOKEN=
